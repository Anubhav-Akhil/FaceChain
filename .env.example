# Copy this file to .env and fill in your keys.
# All services below have free tiers — no credit card required.

# ---- SerpAPI (reverse image search via Google Lens) ---------
# Sign up: https://serpapi.com/  →  250 free searches/month
SERPAPI_KEY=your_serpapi_key_here

# ---- ImgBB (image hosting for public URL) -------------------
# Sign up: https://api.imgbb.com/  →  unlimited free uploads
IMGBB_API_KEY=your_imgbb_api_key_here

# ---- Alchemy (Ethereum Sepolia RPC) -------------------------
# Sign up: https://www.alchemy.com/  →  create a Sepolia app
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key

# ---- Wallet (MetaMask or any Ethereum wallet) ----------------
# Export your private key from MetaMask (Settings → Security)
# Fund with free Sepolia ETH: https://sepoliafaucet.com/
PRIVATE_KEY=your_wallet_private_key_here

# ---- Smart Contract (filled after running deploy_contract.py)
CONTRACT_ADDRESS=
